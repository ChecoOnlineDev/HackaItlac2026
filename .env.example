# Copia este archivo a .env y cambia los valores. NO subas .env al repositorio.

# --- Base de datos (MySQL 8.4 en Docker) ---
MYSQL_HOST=localhost
# Puerto del host donde Docker publica MySQL (dentro del contenedor es 3306).
MYSQL_PUERTO=21001
MYSQL_DATABASE=imhotep
MYSQL_USER=imhotep
MYSQL_PASSWORD=cambia-esta-clave
# Solo para crear el contenedor y las bases de pruebas.
MYSQL_ROOT_PASSWORD=cambia-esta-clave-root

# --- Sesión ---
# Clave para firmar el token de sesión. Genera una con: python -c "import secrets; print(secrets.token_urlsafe(48))"
CLAVE_SESION=cambia-esta-clave-larga
# Duración de la sesión, en horas.
SESION_HORAS=12
# true cuando se sirve por HTTPS (servidor, túnel). false en desarrollo local por http.
COOKIE_SEGURA=false

# --- Autorizaciones ---
# Minutos que vive una solicitud de autorización antes de vencer.
AUTORIZACION_VIGENCIA_MINUTOS=15

# --- Archivos (firmas y fotos) ---
ARCHIVOS_DIR=./almacenamiento
ARCHIVO_TAMANO_MAXIMO=2097152

# --- Datos de prueba (NO son datos reales) ---
# Contraseña y PIN de los usuarios que crea `python -m app.datos_prueba`.
CLAVE_DATOS_PRUEBA=cambia-prueba-123
PIN_DATOS_PRUEBA=1234

# --- Pruebas automáticas ---
# La base de pruebas se llama {MYSQL_DATABASE}_test_{TEST_DB_SUFFIX}.
# Cada carpeta de trabajo que corra pruebas en paralelo debe usar un sufijo distinto.
TEST_DB_SUFFIX=main
