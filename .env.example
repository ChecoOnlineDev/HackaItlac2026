# Copia este archivo a .env y cambia los valores. NO subas .env al repositorio.

# --- Base de datos (MySQL 8.4 en Docker) ---
# Con el backend en tu máquina (uv run ...), MySQL está en localhost. Dentro de Docker Compose
# el servicio `app` ignora estos dos y usa el servicio `db` (puerto 3306).
MYSQL_HOST=localhost
# Puerto del host donde Docker publica MySQL (dentro del contenedor es 3306).
MYSQL_PUERTO=21001
MYSQL_DATABASE=imhotep
MYSQL_USER=imhotep
MYSQL_PASSWORD=cambia-esta-clave
# Solo para crear el contenedor y las bases de pruebas.
MYSQL_ROOT_PASSWORD=cambia-esta-clave-root

# Nombre del contenedor de MySQL. Cámbialo solo si corres otra copia del proyecto en la misma máquina.
DB_CONTENEDOR=imhotep_db

# --- Aplicación (API + interfaz en un solo contenedor) ---
# Puerto del host donde Docker publica la aplicación (dentro del contenedor es 8000).
# Solo escucha en 127.0.0.1; al exterior se publica por el túnel.
APP_PUERTO=21040
# Direcciones de las que se aceptan las cabeceras X-Forwarded-* (el túnel está en la misma red de Docker).
FORWARDED_ALLOW_IPS=*
# Carpeta de la interfaz construida. En la imagen ya viene fijada; solo se cambia a mano en desarrollo.
# INTERFAZ_DIR=/app/interfaz

# --- Túnel de Cloudflare (docs/architecture/despliegue-local-cloudflare.md) ---
# Token del túnel creado en Zero Trust. Es un secreto. Solo se usa con: docker compose --profile tunel up -d
TUNNEL_TOKEN=

# --- Sesión ---
# Clave para firmar el token de sesión. Genera una con: python -c "import secrets; print(secrets.token_urlsafe(48))"
CLAVE_SESION=cambia-esta-clave-larga
# Duración de la sesión, en horas.
SESION_HORAS=12
# true cuando se sirve por HTTPS (servidor, túnel): la cámara y la cookie lo exigen.
# false para entrar por http://127.0.0.1 o http://localhost (de lo contrario no se guarda la sesión).
COOKIE_SEGURA=false

# --- Autorizaciones ---
# Minutos que vive una solicitud de autorización antes de vencer.
AUTORIZACION_VIGENCIA_MINUTOS=15

# --- Archivos (firmas y fotos) ---
# Fuera de Docker. En el contenedor es /data/archivos (volumen nombrado), no se configura aquí.
ARCHIVOS_DIR=./almacenamiento
ARCHIVO_TAMANO_MAXIMO=2097152

# --- Datos de prueba (NO son datos reales) ---
# true: al arrancar el contenedor se cargan los datos de prueba (repetible). Déjalo en false en producción.
CARGAR_DATOS_PRUEBA=false
# Contraseña y PIN de los usuarios que crea `python -m app.datos_prueba`.
CLAVE_DATOS_PRUEBA=cambia-prueba-123
PIN_DATOS_PRUEBA=1234

# --- Pruebas automáticas ---
# La base de pruebas se llama {MYSQL_DATABASE}_test_{TEST_DB_SUFFIX}.
# Cada carpeta de trabajo que corra pruebas en paralelo debe usar un sufijo distinto.
TEST_DB_SUFFIX=main
